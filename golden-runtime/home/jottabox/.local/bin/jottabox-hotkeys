#!/usr/bin/env python3
import os
import time
import select
import subprocess
from evdev import InputDevice, list_devices, ecodes

pressed = {}
last_trigger = 0.0
devices = {}

TARGET_FLATPAKS = [
    "org.libretro.RetroArch",
    "net.pcsx2.PCSX2",
    "org.DolphinEmu.dolphin-emu",
    "org.ppsspp.PPSSPP",
]

TARGET_PROCESSES = [
    "retroarch",
    "pcsx2-qt",
    "PCSX2",
    "dolphin-emu",
    "PPSSPPSDL",
    "PPSSPPQt",
]

def log(msg):
    try:
        os.makedirs(os.path.expanduser("~/.local/share/jottabox/logs"), exist_ok=True)
        with open(os.path.expanduser("~/.local/share/jottabox/logs/hotkeys.log"), "a") as f:
            f.write(time.strftime("%F %T ") + msg + "\n")
    except Exception:
        pass

def rescan():
    global devices, pressed
    new = {}
    for path in list_devices():
        try:
            d = InputDevice(path)
            caps = d.capabilities().get(ecodes.EV_KEY, [])
            # Gamepads normalmente anunciam BTN_GAMEPAD/BTN_SOUTH/BTN_A.
            if any(code in caps for code in (
                ecodes.BTN_GAMEPAD, ecodes.BTN_SOUTH, ecodes.BTN_A,
                ecodes.BTN_JOYSTICK
            )):
                new[d.fd] = d
                pressed.setdefault(d.path, set())
        except Exception:
            pass

    # Fecha descritores que sumiram.
    for fd,d in list(devices.items()):
        if fd not in new:
            try: d.close()
            except Exception: pass

    devices = new

def emulator_running():
    try:
        out = subprocess.check_output(["flatpak","ps","--columns=application"], text=True, stderr=subprocess.DEVNULL)
        if any(app in out for app in TARGET_FLATPAKS):
            return True
    except Exception:
        pass

    for proc in TARGET_PROCESSES:
        if subprocess.run(["pgrep","-f",proc], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            return True
    return False

def close_emulators():
    log("SELECT+START acionado")
    for app in TARGET_FLATPAKS:
        subprocess.run(["flatpak","kill",app], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    for proc in TARGET_PROCESSES:
        subprocess.run(["pkill","-TERM","-f",proc], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def return_to_jottabox():
    # Fecha também o ES-DE. O launcher JottaBox está aguardando o processo
    # gpbox terminar; ao fechar o ES-DE, ele retoma automaticamente.
    time.sleep(0.45)
    subprocess.run(
        ["pkill","-TERM","-f","ES-DE_x64.AppImage"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )
    time.sleep(0.8)

    try:
        ids = subprocess.check_output(
            ["xdotool","search","--name","JottaBox"],
            text=True,
            stderr=subprocess.DEVNULL
        ).split()
        if ids:
            subprocess.run(
                ["xdotool","windowactivate","--sync",ids[-1]],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
    except Exception:
        pass
    log("retorno direto ao JottaBox")

def trigger():
    global last_trigger
    now = time.monotonic()
    if now - last_trigger < 2.0:
        return
    last_trigger = now

    if not emulator_running():
        return

    close_emulators()
    return_to_jottabox()

rescan()
last_scan = time.monotonic()

while True:
    now = time.monotonic()
    if now - last_scan > 3:
        rescan()
        last_scan = now

    if not devices:
        time.sleep(1)
        continue

    try:
        readable,_,_ = select.select(list(devices.values()), [], [], 1.0)
    except Exception:
        rescan()
        continue

    for dev in readable:
        try:
            for event in dev.read():
                if event.type != ecodes.EV_KEY:
                    continue

                keys = pressed.setdefault(dev.path, set())
                if event.value in (1,2):
                    keys.add(event.code)
                elif event.value == 0:
                    keys.discard(event.code)

                # BTN_SELECT + BTN_START é o padrão Linux/evdev
                # para Back/Select + Start em controles Xbox/PS.
                if ecodes.BTN_SELECT in keys and ecodes.BTN_START in keys:
                    trigger()
        except OSError:
            rescan()
            break
        except Exception as e:
            log("erro: " + repr(e))
