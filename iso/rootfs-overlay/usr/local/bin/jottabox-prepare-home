#!/usr/bin/env bash
set -Eeuo pipefail

SEED="/opt/jottabox-live"
MARK="$HOME/.local/share/jottabox/.live-seed-ready"

[[ -d "$SEED/runtime-home" ]] || exit 0
[[ -f "$MARK" ]] && exit 0

mkdir -p "$HOME"

echo "Preparando ambiente JottaBox..."
rsync -a "$SEED/runtime-home/" "$HOME/"

OLD_HOME="$(cat "$SEED/source-home.txt" 2>/dev/null || true)"
if [[ -n "$OLD_HOME" && "$OLD_HOME" != "$HOME" ]]; then
  while IFS= read -r -d '' f; do
    file "$f" 2>/dev/null | grep -qiE 'text|script|json|xml|python' || continue
    sed -i "s#${OLD_HOME//\#/\\#}#${HOME//\#/\\#}#g" "$f" 2>/dev/null || true
  done < <(find "$HOME/.local/bin" "$HOME/.local/share/jottabox" "$HOME/.config/jottabox-console" "$HOME/.emulationstation" "$HOME/ES-DE"            -type f -print0 2>/dev/null)
fi

chmod +x "$HOME/.local/bin"/jottabox-* "$HOME/.local/bin/gpbox" "$HOME/.local/bin/xbox-cloud" 2>/dev/null || true
mkdir -p "$(dirname "$MARK")"
touch "$MARK"
